  static reply(messages: ChatMessage[]): string {
    const users: ChatMessage[] = messages.filter((item: ChatMessage) => item.role === 'user');
    let text: string = users.length > 0 ? users[users.length - 1].content.toLowerCase() : '';
    if (/^(嗯|嗯嗯|是的|对|好|不知道|怎么办|然后呢)[。！!?？]*$/.test(text) && users.length > 1) {
      text = users[users.length - 2].content.toLowerCase();
    }
    const topic: ReplyTopic | undefined = LocalReplyBank.TOPICS.find((item: ReplyTopic) =>
      item.keywords.some((word: string) => text.includes(word)));
    const candidates: string[] = topic === undefined ? LocalReplyBank.DEFAULT : topic.replies;
    const recent: string[] = messages.filter((item: ChatMessage) => item.role === 'assistant').slice(-20)
      .map((item: ChatMessage) => item.content);
    const unused: string[] = candidates.filter((line: string) => recent.indexOf(line) < 0);
    if (unused.length > 0) { return unused[Math.floor(Math.random() * unused.length)]; }
    let selected: string = candidates[0];
    let earliest: number = recent.lastIndexOf(selected);
    candidates.forEach((line: string) => {
      const last: number = recent.lastIndexOf(line);
      if (last < earliest) { earliest = last; selected = line; }
    });
    return selected;
  }
